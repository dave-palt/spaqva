# spaqva.it — GitHub Pages publish set (explicit whitelist)
# Everything else on disk is the local safety copy of the Aruba hosting
# and is intentionally NOT published. Nothing is deleted; just not shipped.

# ignore everything by default
/*

# pages
!/.gitignore
!/CNAME
!/index.html
!/404.html
!/pages/
/pages/*
!/pages/items-pricings.html

# styles
!/bulma.min.css

# vendored FontAwesome 5.15.4 free kit (replaces https://kit.fontawesome.com/2345759d2b.js)
!/fontawesome/
!/fontawesome/css/
!/fontawesome/css/*.css
!/fontawesome/webfonts/
!/fontawesome/webfonts/*

# root images (referenced)
!/logo.png
!/Logo_sample.png
!/helvetia.png
!/hotelsolemar.png
!/abstract_edit.webp
!/footprint_edit.webp
!/spaqva_body_edit.webp

# gallery — only the optimized WebP variants actually referenced
!/images/
/images/*
!/images/20200223-DSC05202-YATE-800.webp
!/images/20200223-DSC05203-TUMAY-800.webp
!/images/20200223-DSC05204-ANGA-800.webp
